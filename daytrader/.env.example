# Alpaca (free paper account): https://app.alpaca.markets -> Paper -> API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Groww Trade API (India): Groww Cloud -> API Keys. Approve the key daily there.
GROWW_API_KEY=
GROWW_API_SECRET=
# ...or the TOTP flow (no daily approval; keep .env private, it can trade):
# GROWW_TOTP_TOKEN=
# GROWW_TOTP_SECRET=

# Zerodha Kite Connect (India; Connect plan for market data): https://developers.kite.trade
# Set the app's redirect URL to http://127.0.0.1:5010/kite
KITE_API_KEY=
KITE_API_SECRET=

# Charles Schwab (optional): https://developer.schwab.com (Dashboard -> Apps)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Phone push alerts (free ntfy app): any hard-to-guess topic name
NTFY_TOPIC=

# Password for the dashboard; required before it is reachable from your phone
DASHBOARD_PASSWORD=
